<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_small_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_card_bg"
    android:orientation="vertical"
    android:padding="12dp">

    <!-- Top Row: CEFR Badge & Streak -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widget_small_cefr"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/widget_cefr_badge_bg"
            android:paddingHorizontal="5dp"
            android:paddingVertical="1dp"
            android:text="B1"
            android:textColor="#1565C0"
            android:textSize="9.5sp"
            android:textStyle="bold" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/widget_small_streak"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🔥 3"
            android:textColor="#1E1B18"
            android:textSize="10sp"
            android:textStyle="bold" />
    </LinearLayout>

    <View
        android:layout_width="1dp"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- Center Word -->
    <TextView
        android:id="@+id/widget_small_word"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="das Wort"
        android:textColor="#1E1B18"
        android:textSize="16sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/widget_small_ipa"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="/vɔʁt/"
        android:textColor="#78716C"
        android:textSize="10.5sp" />

    <TextView
        android:id="@+id/widget_small_def"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:ellipsize="end"
        android:maxLines="2"
        android:text="word, term"
        android:textColor="#8C2D19"
        android:textSize="11.5sp"
        android:textStyle="bold" />

</LinearLayout>
