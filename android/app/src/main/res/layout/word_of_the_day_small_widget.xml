<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_small_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_card_bg"
    android:orientation="vertical"
    android:paddingLeft="13dp"
    android:paddingTop="9dp"
    android:paddingRight="11dp"
    android:paddingBottom="9dp">

    <!-- Top Row: Word (up to 2 lines) on the left, CEFR badge & Next button on the right -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="top"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widget_small_word"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:fontFamily="@font/spline_sans"
            android:maxLines="2"
            android:text="das Wort"
            android:textColor="#1A1614"
            android:textSize="17sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/widget_small_cefr"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/widget_cefr_badge_bg"
                android:fontFamily="@font/spline_sans"
                android:paddingLeft="6dp"
                android:paddingTop="2dp"
                android:paddingRight="6dp"
                android:paddingBottom="2dp"
                android:text="B1"
                android:textColor="#1565C0"
                android:textSize="9sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_small_next"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:background="@drawable/widget_chip_bg"
                android:fontFamily="@font/spline_sans"
                android:gravity="center"
                android:minWidth="32dp"
                android:minHeight="32dp"
                android:paddingLeft="8dp"
                android:paddingTop="4dp"
                android:paddingRight="8dp"
                android:paddingBottom="4dp"
                android:text="›"
                android:textColor="#57534E"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <!-- Meaning / Definitions occupying the available space -->
    <TextView
        android:id="@+id/widget_small_def"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="2dp"
        android:ellipsize="end"
        android:fontFamily="@font/spline_sans"
        android:gravity="top"
        android:lineSpacingExtra="1dp"
        android:maxLines="4"
        android:text="1. word, term\n2. expression, vocable"
        android:textColor="#8C2D19"
        android:textSize="11.5sp"
        android:textStyle="bold" />

</LinearLayout>
