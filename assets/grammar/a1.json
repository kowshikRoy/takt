[
  {
    "id": "lesson_svo_sentence_structure",
    "level": "A1",
    "title": "Basic Sentence Structure (SVO)",
    "subtitle": "How to build standard statements in German",
    "category": "Satzbau",
    "summary": "German declarative sentences follow a Subject-Verb-Object (SVO) word order, where the conjugated verb ALWAYS stays at Position 2.",
    "sections": [
      {
        "id": "svo_explanation",
        "type": "explanation",
        "title": "Die Grundregel (The Fundamental Rule)",
        "explanation_payload": {
          "text": "Standard statements in German follow the exact same core word order as in English: Subject + Verb + Object (SVO).",
          "bullet_points": [
            "Position 1: The Subject (Who is doing the action?)",
            "Position 2: The Conjugated Verb (Action word - strictly locked in Pos 2!)",
            "Position 3: Object or additional information"
          ]
        }
      },
      {
        "id": "svo_formula",
        "type": "formula",
        "title": "Satzbau-Formel (Word Order Formula)",
        "formula_payload": {
          "formula_structure": "Subject (Pos 1) + Verb (Pos 2) + Object (Pos 3)",
          "blocks": [
            {
              "position": "Position 1",
              "label": "Subjekt",
              "example_word": "Ich",
              "color_tag": "neutral"
            },
            {
              "position": "Position 2",
              "label": "Verb (Pos 2)",
              "example_word": "lerne",
              "color_tag": "primary"
            },
            {
              "position": "Position 3",
              "label": "Objekt",
              "example_word": "Deutsch.",
              "color_tag": "accent"
            }
          ]
        }
      },
      {
        "id": "svo_examples",
        "type": "examples",
        "title": "Beispielsätze (Example Sentences)",
        "example_payload": [
          {
            "german": "Ich lerne Deutsch.",
            "english": "I learn German.",
            "note": "Ich (Subject) + lerne (Verb) + Deutsch (Object)",
            "highlighted_words": [
              "Ich",
              "lerne",
              "Deutsch"
            ]
          },
          {
            "german": "Ich trinke Wasser.",
            "english": "I drink water.",
            "note": "Verb 'trinke' is at Position 2.",
            "highlighted_words": [
              "trinke"
            ]
          },
          {
            "german": "Ich esse Brot.",
            "english": "I eat bread.",
            "note": "Verb 'esse' is at Position 2.",
            "highlighted_words": [
              "esse"
            ]
          }
        ]
      }
    ]
  },
  {
    "id": "lesson_personal_pronouns",
