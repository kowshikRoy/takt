    "title": "Personal Pronouns (Personalpronomen)",
    "subtitle": "Learning I, you, he, she, it, we, they",
    "category": "Pronomen & Verben",
    "summary": "Personal pronouns replace nouns. German distinguishes between informal 'du' (singular you), 'ihr' (plural you), and formal 'Sie'.",
    "sections": [
      {
        "id": "pronouns_table",
        "type": "table",
        "title": "Personalpronomen Übersicht",
        "table_payload": {
          "headers": [
            "Person",
            "Deutsch",
            "English",
            "Usage Note"
          ],
          "rows": [
            [
              "1st Singular",
              "ich",
              "I",
              "Always lowercase unless at sentence start"
            ],
            [
              "2nd Singular",
              "du",
              "you (informal)",
              "Used with friends, family, children"
            ],
            [
              "3rd Singular (M)",
              "er",
              "he",
              "Replaces masculine nouns (der Tisch → er)"
            ],
            [
              "3rd Singular (F)",
              "sie",
              "she",
              "Replaces feminine nouns (die Katze → sie)"
            ],
            [
              "3rd Singular (N)",
              "es",
              "it",
              "Replaces neuter nouns (das Haus → es)"
            ],
            [
              "1st Plural",
              "wir",
              "we",
              "Plural 'we'"
            ],
            [
              "2nd Plural",
              "ihr",
              "you all (informal)",
              "Addressing 2+ friends/family members"
            ],
            [
              "3rd Plural",
              "sie",
              "they",
              "Lowercase 's'"
            ],
            [
              "Formal",
              "Sie",
              "You (formal)",
              "Capital 'S'! Used for strangers, adults, bosses"
            ]
          ],
          "footnote": "Pay attention to 'sie/Sie': 'sie' can mean 'she' or 'they', while capital 'Sie' means formal 'you'!"
        }
      },
      {
        "id": "pronouns_examples",
        "type": "examples",
        "title": "Beispielsätze mit Pronomen",
        "example_payload": [
          {
            "german": "Ich bin müde.",
            "english": "I am tired.",
            "note": "'ich' paired with verb 'bin'",
            "highlighted_words": [
